<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the in-app "send test notification" debug button. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      "Display over other apps". Needed as the Android background-activity-launch exemption so the
      notification listener (procstate BOUND_FOREGROUND_SERVICE) may start the indicator on the cover.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_dot"
        android:label="@string/app_name"
        android:theme="@style/Theme.CoverLED">

        <!-- Debug / control UI on the main screen -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ColorsActivity"
            android:exported="false"
            android:label="App colors" />

        <!--
          The LED itself. Launched on the cover display (see CoverDisplays.kt).
          showWhenLocked / turnScreenOn are also set programmatically for older paths.
          resizeableActivity is required so the system allows it on a non-default display.
        -->
        <activity
            android:name=".CoverIndicatorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="dev.lucas.coverled.indicator"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:theme="@style/Theme.CoverLED.Indicator" />

        <!-- Notification listener (spec §6.1). User must grant Notification access in Settings. -->
        <service
            android:name=".LedNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
