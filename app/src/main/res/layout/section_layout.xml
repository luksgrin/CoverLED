<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="When several apps are waiting" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgArrangement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/rbRow" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Row" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rbGeometric" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Shape" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rbCycle" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Cycle" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView android:id="@+id/txtArrangementHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

    <TextView android:id="@+id/lblSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/sbSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="8" android:valueTo="64" android:stepSize="1" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Up to 6 dots. Priority apps come first (see Apps); with more than 6 apps waiting the last dot is white and means “more”." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
