<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swBlink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:text="@string/blink_switch"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/beat_style" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/rbHard" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/style_blink" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rbBreathe" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/style_breathe" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rbLubdub" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/style_lubdub" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView android:id="@+id/lblBlinkOn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/sbBlinkOn" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="200" android:valueTo="3000" android:stepSize="100" />

    <TextView android:id="@+id/lblBlinkOff" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/sbBlinkOff" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="500" android:valueTo="15000" android:stepSize="500" />

    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" />

    <TextView android:id="@+id/lblBrightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/sbBrightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="100" android:stepSize="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brightness_help" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="12dp"
        android:text="@string/battery_switch"
        android:textAppearance="?attr/textAppearanceBodyLarge" />
</LinearLayout>
